<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime silently refuses Apple Events without it, and the app
	     quits an editor (Cursor, Antigravity) with osascript before switching it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
